        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.resetToken) {",
                  "    pm.globals.set(\"resetToken\", jsonData.data.resetToken);",
                  "    pm.collectionVariables.set(\"resetToken\", jsonData.data.resetToken);",
                  "    try { pm.environment.set(\"resetToken\", jsonData.data.resetToken); } catch(e) {}",
                  "    console.log(\"Reset Token automatically saved everywhere!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
